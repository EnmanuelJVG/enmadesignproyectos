// Reglas de seguridad de Firestore para ENMA Studio Manager.
// Cámbialas en Firebase: Firestore Database → pestaña "Reglas" → pega esto → Publicar.
// IMPORTANTE: reemplaza TU_CORREO@gmail.com por EL MISMO correo con el que creaste tu usuario en Authentication.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo tu usuario, con tu correo, puede leer y escribir en su propia carpeta. Todo lo demás está cerrado.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.token.email == 'TU_CORREO@gmail.com';
    }
  }
}
